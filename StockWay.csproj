<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockWay</RootNamespace>
    <AssemblyName>StockWay</AssemblyName>
    <!-- Permite rodar também em máquinas que só têm .NET 9 ou 10 instalado -->
    <RollForward>LatestMajor</RollForward>
    <!-- Gera o XML com os comentários /// para aparecerem no Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Segredos de desenvolvimento (chave do Brevo etc.) ficam fora do projeto: dotnet user-secrets set ... -->
    <UserSecretsId>e2bdf9c7-8ddc-4e05-820c-b7a93428ea22</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Disponível em todos os arquivos sem precisar de "using" -->
    <Using Include="StockWay.Common" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- Login: validação do token JWT enviado no cabeçalho Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
  </ItemGroup>

</Project>
